[Unit]
Description=Algua forage — web inspiration foraging (agent, scratch worktree)
# Fired by algua-forage.timer. An agent, with optional bwrap containment through run_agent.sh,
# bash denied outright (it runs no algua command at all) and the runtime's
# configured web tools, writes inspiration notes under kb/inspirations/ inside
# a throwaway worktree (.runs/forage-<stamp>). The agent has NO registry path (no ALGUA_DB_PATH)
# and is told never to run an `algua` command — it can only write markdown files. The TRUSTED
# DRIVER (this unit's ExecStart, after the agent exits) validates and lands the survivors into the
# vault via `algua research inspirations accept`, parses the agent's proposed-venue list into
# `research inspirations propose`, and appends one digest line to data/forage-runs.jsonl.
# MCP tools use declarative runtime configuration; no FORAGE_MCP bypass exists. Filesystem
# sandboxing is mode-dependent and does not isolate networking or all readable host data.

[Service]
Type=oneshot
EnvironmentFile=/etc/algua/algua.env
# Scrub broker credentials — foraging never needs them. Shell tool denial and optional bwrap
# containment do not establish a network or complete host-data isolation boundary.
UnsetEnvironment=ALGUA_ALPACA_API_KEY ALGUA_ALPACA_API_SECRET ALGUA_ALPACA_LIVE_API_KEY ALGUA_ALPACA_LIVE_API_SECRET
WorkingDirectory=/opt/algua
# The driver bounds the agent run itself (FORAGE_TIMEOUT, default 20m) and the env pre-warm
# (SYNC_TIMEOUT, default 5m). This is the last-resort backstop if the wrapper itself hangs (e.g.
# a stuck flock) — kept comfortably above the driver's own caps so the driver's own timeout fires
# first with a clean non-zero exit instead of systemd SIGKILLing mid-run.
TimeoutStartSec=1800
# opencode must be on PATH and AUTHENTICATED for the user this unit runs as (see README).
ExecStart=/opt/algua/.opencode/scripts/forage.sh --scheduled

[Install]
WantedBy=multi-user.target
