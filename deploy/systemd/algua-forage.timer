[Unit]
Description=Algua forage timer — bounded inspiration refill checks

[Timer]
# Check hourly. The trusted driver launches only for an empty eligible research queue or the
# 03 UTC refresh, at most twice per UTC day and at least two hours apart. Idle checks do not
# rotate categories or spend a launch. Each actual launch advances the existing category cursor.
OnCalendar=*-*-* *:05:00 UTC
# Catch up a fire missed while the box was off; the rotation cursor is durable on disk, so a late
# fire just forages whatever slice is next.
Persistent=true

[Install]
WantedBy=timers.target
