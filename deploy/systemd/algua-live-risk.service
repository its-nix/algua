[Unit]
Description=Algua installed live risk check (DRAFT; separate human activation required)
After=network-online.target

[Service]
Type=oneshot
User=algua-live
Group=algua-live
WorkingDirectory=/var/lib/algua-live
EnvironmentFile=/etc/algua/live.env
ExecStart=/usr/local/libexec/algua-live-entry operator lock-run -- /usr/local/libexec/algua-live-entry risk check live
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictNamespaces=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
ReadWritePaths=/var/lib/algua-live
UMask=0077
KillMode=control-group
TimeoutStartSec=180
