[Unit]
Description=Dedicated public HTTPS ingress for Algua
Requires=algua-google-auth.socket
After=network-online.target algua-google-auth.socket algua-web.service
Wants=network-online.target algua-web.service

[Service]
Type=simple
ExecStartPre=/usr/sbin/nginx -t -c /etc/algua-ingress/nginx.conf
ExecStart=/usr/sbin/nginx -c /etc/algua-ingress/nginx.conf -g "daemon off;"
ExecReload=/usr/sbin/nginx -s reload -c /etc/algua-ingress/nginx.conf
KillSignal=SIGQUIT
TimeoutStopSec=10
Restart=on-failure
RuntimeDirectory=algua-ingress
RuntimeDirectoryMode=0755
LogsDirectory=algua-ingress
UMask=0027
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/run/algua-ingress /var/log/algua-ingress

[Install]
WantedBy=multi-user.target
