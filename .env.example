# Algua configuration (prefix ALGUA_). Copy to .env for local overrides.
ALGUA_DB_PATH=data/algua.db
ALGUA_DATA_DIR=data
ALGUA_EXCHANGE=XNYS
ALGUA_ALPACA_API_KEY=
ALGUA_ALPACA_API_SECRET=
ALGUA_ALPACA_DATA_URL=https://data.alpaca.markets/v2
# Optional automatic research launch cap per UTC day (1–100). Unset preserves uncapped manual use.
# Failed admitted launches consume budget; new ideas can trigger the existing serialized worker.
ALGUA_RESEARCH_DAILY_CYCLE_LIMIT=4
